{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "MockAuth": {
    "Issuer": "https://localhost:7443/",
    "PublicClientIds": [],
    "RedirectUris": [
      "http://localhost:5173/callback",
      "https://localhost:5173/callback",
      "https://localhost:7239/swagger/callback",
      "https://localhost:7239/hangfire/callback"
    ],
    "LogoutRedirectUris": [
      "http://localhost:5173",
      "https://localhost:5173",
      "https://localhost:7239"
    ],
    "AccessTokenLifetimeSeconds": 3600,
    "RefreshTokenLifetimeSeconds": 7200,
    "AuthorizationCodeLifetimeSeconds": 60,
    "LoginRequestLifetimeSeconds": 900,
    "MaximumStoredGrants": 10000,
    "AllowInsecureHttp": false
  }
}
